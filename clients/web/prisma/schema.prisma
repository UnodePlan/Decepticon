generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Target types ─────────────────────────────────────────────────────
// Network/web attack surface targets supported by the self-hosted platform.

enum TargetType {
  web_url
  ip_range
}

enum EngagementStatus {
  draft
  planning
  running
  completed
  failed
}

// ── Application models ───────────────────────────────────────────────

model Engagement {
  id                     String           @id @default(cuid())
  name                   String
  targetType             TargetType
  targetValue            String
  authorizationConfirmed Boolean          @default(false)
  status                 EngagementStatus @default(draft)

  // Self-hosted single-user mode — userId is always "local".
  userId      String           @default("local")

  // LangGraph thread tracking
  threadId      String?
  workspacePath String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

// ── Operator-editable runtime settings ───────────────────────────────
// Single-row-per-key store for the settings the dashboard exposes on its
// Settings page (model policy, language, LLM timeouts, display endpoints).
// Values are stored as strings so the table stays schema-free as knobs are
// added — validation and defaults live in `src/lib/system-settings.ts`, and the
// effect boundary of each field (next terminal session / next page load /
// stored-only) is documented in `docs/web-dashboard.md`.
//
// Deployment-level configuration (ports, database URL, auth bootstrap) is NOT
// stored here: it is injected by the launcher/compose at container start and is
// surfaced read-only in the settings API.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
